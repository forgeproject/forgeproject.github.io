# ---------------------------------------------
# OS / System Junk
# ---------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ---------------------------------------------
# Archives (ignore accidental uploads)
# ---------------------------------------------
*.rar
*.7z
*.tar
*.gz

# ---------------------------------------------
# Editor / IDE Junk
# ---------------------------------------------
# VS Code
.vscode/
.history/

# JetBrains
.idea/
*.iml

# Notepad++, Sublime, etc.
*.bak
*.tmp

# ---------------------------------------------
# Logs / Debug / Temp Files
# ---------------------------------------------
*.log
*.tmp
*.temp
*.cache
cache/
temp/

# ---------------------------------------------
# Build / Output / Generated Files
# ---------------------------------------------
build/
dist/
out/
generated/

# ---------------------------------------------
# Node / Python / Tooling (just in case)
# ---------------------------------------------
node_modules/
venv/
__pycache__/

# ---------------------------------------------
# Personal / Private Files
# ---------------------------------------------
*.env
*.secret
*.key
*.credentials

# ---------------------------------------------
# Ignore system-level metadata in your repo
# ---------------------------------------------
*.swp
*.swo

# ---------------------------------------------
# TotalMiner-specific
# ---------------------------------------------
# Ignore autosaves or temporary world files
autosave/
backup/

# Ignore temporary mod build folders
mod_temp/
mod_build/

# Ignore extracted texture/model caches
textures_cache/
models_cache/

# ---------------------------------------------
# Keep your actual content!
# ---------------------------------------------
# DO NOT ignore:
# - .zip (mods/maps)
# - .tmworld (maps)
# - .lua or .txt scripts
# - assets, textures, models
# - tools you want to share
#
# So we explicitly allow them:
!*.tmworld
!*.zip
!*.lua
!*.txt
!assets/
!maps/
!mods/
!tools/

